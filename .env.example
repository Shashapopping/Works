# Copy to droplet .env — never commit real secrets.

# Auth — session cookies (default) or JWT for local experiments
# AUTH_MODE=session
# AUTH_MODE=jwt
# JWT_SECRET=your-local-jwt-secret

PORT=3003
NODE_ENV=production
AUTH_COOKIE_SECURE=1

# First-boot admin only (created if users table is empty). Change after first login.
# AUTH_BOOTSTRAP_NAME should be the real person's display name (shown in the sidebar).
AUTH_BOOTSTRAP_EMAIL=admin@yourdomain.com
AUTH_BOOTSTRAP_PASSWORD=ReplaceWithStrongPassword!
AUTH_BOOTSTRAP_NAME=Your Name

# Fleet API (frontend build uses VITE_API_SECRET in GitHub Actions)
API_SECRET=
VITE_API_SECRET=

# MiX Telematics
MIX_USERNAME=
MIX_PASSWORD=
MIX_CLIENT_ID=
MIX_CLIENT_SECRET=
LAFARGE_ORG_ID=

# Optional — frontend demo branding (local only; put true in .env.local, never commit)
# VITE_DEMO_BRANDING=true

GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
# Optional email (Resend) — invite when Admin creates users; also first password-change confirm
RESEND_API_KEY=
RESEND_FROM=HBM Fleet <noreply@hbm.bestpracticesltd.com.ng>
APP_PUBLIC_URL=https://hbm.bestpracticesltd.com.ng
# CLIENT_SEAT_LIMIT=12

# Sign in with Google — one OAuth client, register BOTH redirect URIs in Google Cloud:
#   https://hbm.bestpracticesltd.com.ng/api/auth/oauth/google/callback
#   http://localhost:5173/api/auth/oauth/google/callback
# Local .env: APP_PUBLIC_URL=http://localhost:5173
# Prod droplet .env: APP_PUBLIC_URL=https://hbm.bestpracticesltd.com.ng
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_DOMAINS=bestpracticesltd.com,bestpracticesltd.com.ng
